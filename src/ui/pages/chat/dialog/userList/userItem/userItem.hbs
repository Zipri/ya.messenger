<li class="user-item">
    <div class="user-item__info">
        {{#if avatar}}
            <img src="{{avatar}}" alt="{{first_name}}" class="user-item__avatar"/>
        {{else}}
            <div class="user-item__avatar-placeholder"></div>
        {{/if}}
        <span class="user-item__name">{{first_name}}</span>
    </div>
    {{#unless isOwn}}
        {{{deleteBtn}}}
    {{/unless}}
</li>

