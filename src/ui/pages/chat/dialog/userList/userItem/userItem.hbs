<li class="user-item">
    <div class="user-item__info">
        {{#if avatar}}
            <img src="{{avatar}}" alt="{{name}}" class="user-item__avatar"/>
        {{else}}
            <div class="user-item__avatar-placeholder"></div>
        {{/if}}
        <span class="user-item__name">{{name}}</span>
    </div>
    {{#unless isOwn}}
        <button class="user-item__delete-btn">X</button>
    {{/unless}}
</li>

